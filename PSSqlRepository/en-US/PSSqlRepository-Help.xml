    <command:examples>
      <command:example>
        <maml:title>--------- Example 1 ---------</maml:title>
        <maml:introduction>
          <maml:para>Loads an entity, changes a property and writes it back; an id that does not exist fails instead of inserting.</maml:para>
        </maml:introduction>
        <dev:code>$customer = Get-PSSqlRepositoryEntity -EntityType ([Customer]) -Id 5
$customer.Name = 'Renamed'
